{
  "name": "anima-2.9b-text2image",
  "displayName": "Anima 2.9B 文生图",
  "baseModel": "Anima",
  "type": "text2image_with_lora",
  "category": "文生图",
  "version": "1.0",
  "icon": "icon.svg",
  "displayImage": ["display.webp"],
  "description": "基于 Anima 2.9B（NVIDIA Cosmos 架构，动漫/非写实插画风格）的文生图工作流，支持 LoRA 人物/画风优化",
  "workflowFile": "workflow.json",
  "dependenciesFile": "dependencies.json",
  "adapterClass": "io.dramatrix.plugin.anima.AnimaText2ImageAdapter",
  "extra": {
    "unet_name": "Anima-2.9B-preview-v1.safetensors",
    "steps": 30,
    "cfg": 1.0,
    "paramSchema": [
      {
        "key": "negativePrompt",
        "label": "反向提示词",
        "type": "TEXTAREA",
        "placeholder": "不希望出现的元素…",
        "tooltip": "否定内容，如 低质量、畸形手部"
      },
      {
        "key": "steps",
        "label": "采样步数",
        "type": "NUMBER",
        "min": 1,
        "max": 100,
        "interval": 1
      },
      {
        "key": "cfg",
        "label": "CFG",
        "type": "NUMBER",
        "min": 0,
        "max": 20,
        "step": 0.5
      },
      {
        "key": "seed",
        "label": "随机种子",
        "type": "NUMBER",
        "placeholder": "留空随机"
      }
    ]
  }
}