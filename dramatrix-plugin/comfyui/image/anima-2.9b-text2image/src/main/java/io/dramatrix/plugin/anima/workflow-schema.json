{
  "parameters": [
    { "key": "prompt", "type": "string", "required": true, "desc": "正向提示词（自然语言 + Danbooru 标签）" },
    { "key": "negative_prompt", "type": "string", "desc": "负向提示词（可选，缺省用工作流默认）" },
    { "key": "lora", "type": "string", "desc": "LoRA 模型" },
    { "key": "unet_name", "type": "string", "desc": "UNET 模型名（extra.unet_name 覆盖）" },
    { "key": "steps", "type": "int", "desc": "采样步数（extra.steps 覆盖）" },
    { "key": "cfg", "type": "float", "desc": "CFG（extra.cfg 覆盖）" },
    { "key": "seed", "type": "int", "desc": "随机种子" },
    { "key": "width", "type": "int", "desc": "生成宽度（16 的倍数）" },
    { "key": "height", "type": "int", "desc": "生成高度（16 的倍数）" }
  ],
  "output": { "kind": "image" }
}