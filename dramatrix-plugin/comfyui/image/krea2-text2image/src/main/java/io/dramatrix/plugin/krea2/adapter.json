{
  "name": "krea2-text2image",
  "displayName": "Krea2 白玉 文生图",
  "baseModel": "Krea2",
  "type": "text2image_with_lora",
  "category": "文生图",
  "version": "1.0",
  "icon": "icon.svg",
  "displayImage": ["display.webp"],
  "description": "基于 Krea2 白玉（Krea2-turbo White Marble AIO）的文生图工作流，6 步 turbo 蒸馏采样，支持 LoRA 人物优化",
  "workflowFile": "workflow.json",
  "dependenciesFile": "dependencies.json",
  "adapterClass": "io.dramatrix.plugin.krea2.Krea2Text2ImageAdapter",
  "extra": {
    "paramSchema": [
      {
        "key": "steps",
        "label": "采样步数",
        "type": "NUMBER",
        "min": 1,
        "max": 100,
        "interval": 1,
        "defaultValue": 6
      },
      {
        "key": "cfg",
        "label": "CFG",
        "type": "NUMBER",
        "min": 0,
        "max": 20,
        "step": 0.5,
        "defaultValue": 1.0
      },
      {
        "key": "seed",
        "label": "随机种子",
        "type": "NUMBER",
        "placeholder": "留空随机"
      }
    ]
  }
}
