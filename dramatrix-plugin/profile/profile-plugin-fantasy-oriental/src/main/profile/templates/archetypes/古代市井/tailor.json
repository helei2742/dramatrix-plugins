  },
  "templateFluxPrompt": "a {gender} tailor, {ageDesc}, {bodyType}, {faceDesc}, wearing {defaultClothes}, {hairStyle} {hairColor} hair, {eyeColor} eyes, {skinColor} skin, {temperament} aura, fabric shop with colorful silk rolls, measuring tape, ancient china, masterpiece"
